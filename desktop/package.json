{
  "name": "keeps-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Keeps desktop prototype - build plans from saved conversations",
  "author": "Mohammed Farhan Bin Abdul Razak",
  "main": "main.cjs",
  "scripts": {"prepare-app": "node prepare.cjs", "build:win": "npm run prepare-app && electron-builder --win portable --x64 --publish never"},
  "devDependencies": {"electron": "45.2.3", "electron-builder": "26.18.0", "@fontsource/dm-sans": "5.2.8"},
  "build": {
    "appId": "com.keeps.prototype",
    "productName": "Keeps",
    "asar": true,
    "directories": {"output": "release"},
    "files": ["main.cjs", "app/**/*", "package.json"],
    "win": {"target": "portable", "signAndEditExecutable": false},
    "portable": {"artifactName": "Keeps-1.0.0-Windows-x64.exe"}
  }
}
